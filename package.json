{
  "name": "webview-vscode",
  "displayName": "Webview Sites",
  "version": "0.1.1",
  "description": "Open configured web apps in VS Code's integrated browser.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "browser",
    "sandstorm",
    "web app",
    "webview"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/1kbgz/webview-vscode"
  },
  "publisher": "timkpaine",
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --production",
    "esbuild-base": "node esbuild.js",
    "esbuild": "node esbuild.js",
    "esbuild-watch": "node esbuild.js --watch",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "oxlint src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.27.3",
    "glob": "^13.0.6",
    "mocha": "^12.0.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^5.3.3"
  },
  "contributes": {
    "configuration": {
      "title": "Webview",
      "properties": {
        "webview.sites": {
          "type": "array",
          "default": [],
          "description": "Web apps that can be opened in a VS Code tab.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Tab and list label."
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "URL to open."
              }
            }
          }
        }
      }
    },
    "commands": [
      {
        "command": "webview.open",
        "title": "Open Site",
        "category": "Webview"
      },
      {
        "command": "webview.addSite",
        "title": "Add Site",
        "category": "Webview",
        "icon": "$(add)"
      },
      {
        "command": "webview.removeSite",
        "title": "Remove Site",
        "category": "Webview",
        "icon": "$(trash)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "webview.sites",
          "name": "Webview Sites"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "webview.addSite",
          "when": "view == webview.sites",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "webview.removeSite",
          "when": "view == webview.sites",
          "group": "inline"
        }
      ]
    }
  },
  "activationEvents": [],
  "engines": {
    "vscode": "^1.75.0"
  }
}
